{
  "manifest_version": 3,
  "name": "RAM Limiter",
  "version": "2.1",
  "key": "",
  "description": "Unloads the tabs you haven't viewed for the longest when your browser goes over your limit.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["alarms", "favicon", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["typed.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["busy.js"], "all_frames": true, "run_at": "document_start", "world": "MAIN" }
  ]
}
